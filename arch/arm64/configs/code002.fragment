# ===== 基线（已验证可开机）=====
CONFIG_ZRAM=m
CONFIG_ZSMALLOC=m
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_SCHED_BORE is not set

# ===== 第一批（已验证）=====
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_FHANDLE=y
CONFIG_PROC_CHILDREN=y
CONFIG_NTSYNC=y
CONFIG_SQUASHFS=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_SCHED_CLUSTER=y
CONFIG_PREEMPT_DYNAMIC=y

# ===== 第二批：LXC 完整 =====
# 命名空间
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
# 容器网络
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_VLAN_8021Q=m
# 文件系统能力
CONFIG_FANOTIFY=y
CONFIG_CUSE=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_OVERLAY_FS_METACOPY=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_BINFMT_MISC=y

# ===== 第三批：LXC 网络完整 =====
CONFIG_IP6_NF_NAT=y
CONFIG_VXLAN=y

CONFIG_IP6_NF_TARGET_MASQUERADE=y

# ===== 性能批次：DAMON =====
CONFIG_DAMON=y
CONFIG_DAMON_VADDR=y
CONFIG_DAMON_PADDR=y
CONFIG_DAMON_SYSFS=y
CONFIG_DAMON_RECLAIM=y
CONFIG_DAMON_LRU_SORT=y
CONFIG_HZ_300=y

# ===== zram 多压缩器（配合 systemless 模块替换厂商 zram.ko）=====
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZ4HC=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_DEFLATE=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

# ===== zram 多压缩器（配合 systemless 模块替换厂商 zram.ko）=====
# ===== 基线（已验证可开机）=====
# ===== 第一批（已验证）=====
# ===== 第二批：LXC 完整 =====
# 命名空间
# 容器网络
# 文件系统能力
# ===== 第三批：LXC 网络完整 =====
# ===== 性能批次：DAMON =====
# ===== zram 多压缩器（配合 systemless 模块替换厂商 zram.ko）=====
# ===== zram 多压缩器（配合 systemless 模块替换厂商 zram.ko）=====

# ===== 第四批：LXC 全开（ABI 保全，KMI_EXT 方案）=====
# AppArmor 不开：与 Android SELinux 冲突（LSM hook 表无法保全）
# --- 桥接 netfilter（把 hooks_bridge 挪出 struct net）---
CONFIG_ANDROID_BRIDGE_NETFILTER_KMI_EXT=y
CONFIG_BRIDGE_NETFILTER=y
# --- IPVS（skb 标志塞进 tc_index 前的布局空洞）---
CONFIG_ANDROID_IPVS_KMI_EXT=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
# --- SCTP（csum_not_inet 改用 skb_ext 私有槽位 6）---
CONFIG_ANDROID_SCTP_KMI_EXT=y
# --- hugetlb（mm_struct 用 KABI 保留槽）---
CONFIG_ANDROID_HUGETLB_KMI_EXT=y
CONFIG_ANDROID_CGROUP_HUGETLB_KMI_EXT=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_HUGETLBFS=y
# --- cgroup perf / net_cls（子系统用 KABI 保留槽）---
CONFIG_ANDROID_CGROUP_PERF_KMI_EXT=y
CONFIG_CGROUP_PERF=y
CONFIG_ANDROID_CGROUP_NET_CLASSID_KMI_EXT=y
CONFIG_NET_CLS_CGROUP=y
# --- btrfs（blkcg 异步 bio 走 KABI 保留槽）---
CONFIG_ANDROID_BLKCG_PUNT_BIO_KMI_EXT=y
CONFIG_BTRFS_FS_POSIX_ACL=y
# --- ipvlan（不启用 L3S，避免 net_device 变化）---
CONFIG_IPVLAN=y

# ===== LXC 全开（模块化，与 GKI 的 tristate 选择一致）=====
# 这些在 GKI 里本来就是 =m，Kleaf 的模块清单按 =m 校验
CONFIG_IP_VS=m
CONFIG_IP_VS_RR=m
CONFIG_NETFILTER_XT_MATCH_IPVS=m
CONFIG_IP_SCTP=m
CONFIG_BTRFS_FS=m
CONFIG_XOR_BLOCKS=m
CONFIG_CRYPTO_XXHASH=m
CONFIG_RAID6_PQ=m

# nftables 保持内置（设备 system_dlkm 没有这些 .ko，内置才不会丢功能）
CONFIG_NF_TABLES=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_COMPAT=y

# ===== AppArmor（lxc-checkconfig 补全用）=====
# 注意：SELinux 在 CONFIG_LSM 里排在 apparmor 之前，两者都是独占型 LSM，
# 因此 AppArmor 只会被编译进来、运行时不会激活（SELinux 保持生效）
CONFIG_SECURITY_APPARMOR=y

# ===== OpenZFS（built-in，kernel 侧；用户态工具另装）=====
CONFIG_ZFS=m
