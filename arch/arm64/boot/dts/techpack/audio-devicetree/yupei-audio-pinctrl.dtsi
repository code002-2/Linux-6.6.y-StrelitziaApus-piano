			function = "gpio";
		};

		config {
			pins = "gpio3";
			drive-strength = <6>;
			bias-disable;
		};
	};

	fs19xx_irq_active_top_left: fs19xx_irq_active_top_left {
		mux {
			pins = "gpio127";
			function = "gpio";
		};

		config {
			pins = "gpio127";
			drive-strength = <2>;
			bias-disable;
			input-enable;
		};
	};

	fs19xx_irq_sleep_top_left: fs19xx_irq_sleep_top_left {
		mux {
			pins = "gpio127";
			function = "gpio";
		};

		config {
			pins = "gpio127";
			drive-strength = <2>;
			bias-disable;
			input-enable;
		};
	};

	fs19xx_irq_active_top_right: fs19xx_irq_active_top_right {
		mux {
			pins = "gpio149";
			function = "gpio";
		};

		config {
			pins = "gpio149";
			drive-strength = <2>;
			bias-disable;
			input-enable;
		};
	};

	fs19xx_irq_sleep_top_right: fs19xx_irq_sleep_top_right {
		mux {
			pins = "gpio149";
			function = "gpio";
		};

		config {
			pins = "gpio149";
			drive-strength = <2>;
			bias-disable;
			input-enable;
		};
	};

	fs19xx_irq_active_bottom_left: fs19xx_irq_active_bottom_left {
		mux {
			pins = "gpio100";
			function = "gpio";
		};

		config {
			pins = "gpio100";
			drive-strength = <2>;
			bias-disable;
			input-enable;
		};
	};

	fs19xx_irq_sleep_bottom_left: fs19xx_irq_sleep_bottom_left {
		mux {
			pins = "gpio100";
			function = "gpio";
		};

		config {
			pins = "gpio100";
			drive-strength = <2>;
			bias-disable;
			input-enable;
		};
	};

	fs19xx_irq_active_bottom_right: fs19xx_irq_active_bottom_right {
		mux {
			pins = "gpio3";
			function = "gpio";
		};

		config {
			pins = "gpio3";
			drive-strength = <2>;
			bias-disable;
			input-enable;
		};
	};

	fs19xx_irq_sleep_bottom_right: fs19xx_irq_sleep_bottom_right {
		mux {
			pins = "gpio3";
			function = "gpio";
		};

		config {
			pins = "gpio3";
			drive-strength = <2>;
			bias-disable;
			input-enable;
		};
	};

	cdc_dmic_enable_pinctrl {
		cdc_dmic_enable_active: cdc_dmic_enable_active {
			mux {
				pins = "gpio152";
				function = "gpio";
			};

			config {
				pins = "gpio152";
				drive-strength = <8>;
				bias-pull-up;
				output-high;
			};
		};

		cdc_dmic_enable_sleep: cdc_dmic_enable_sleep {
			mux {
				pins = "gpio152";
				function = "gpio";
			};

			config {
				pins = "gpio152";
				drive-strength = <2>;
				bias-disable;
				output-low;
			};
		};
	};
};
