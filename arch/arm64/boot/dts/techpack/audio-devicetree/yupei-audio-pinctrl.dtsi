&lpi_tlmm {
	cdc_dmic23_clk_active_p82: dmic23_clk_active_p82 {
		mux {
			pins = "gpio8";
			function = "func1";
		};

		config {
			pins = "gpio8";
			drive-strength = <4>;
			output-high;
		};
	};

	cdc_dmic23_data_active_p82: dmic23_data_active_p82 {
		mux {
			pins = "gpio9";
			function = "func1";
		};

		config {
			pins = "gpio9";
			drive-strength = <4>;
			input-enable;
		};
	};
};

&tlmm {
	sia91xx_gpio_LT_RESET: sia91xx_gpio_LT_RESET {
		mux {
			pins = "gpio124";
			function = "gpio";
		};

		config {
			pins = "gpio124";
			drive-strength = <6>;
			bias-disable;
		};
	};

	sia91xx_gpio_LT_IRQ: sia91xx_gpio_LT_IRQ {
		mux {
			pins = "gpio127";
			function = "gpio";
		};

		config {
			pins = "gpio127";
			drive-strength = <6>;
			bias-disable;
		};
	};

	sia91xx_gpio_RT_RESET: sia91xx_gpio_RT_RESET {
		mux {
